{
    "name": "testik",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "concurrently --kill-others --names web,api \"npm:dev:web\" \"npm:dev:api\"",
        "dev:web": "vite --host 0.0.0.0",
        "dev:api": "tsx watch server/index.ts",
        "build": "npm run build:web && npm run build:api",
        "build:web": "tsc --noEmit && vite build",
        "build:api": "tsc -p tsconfig.server.json",
        "start:api": "node dist-server/index.js",
        "test:api": "tsx --test server/app.test.ts",
        "db:up": "docker compose up -d --wait postgres",
        "db:down": "docker compose down",
        "db:status": "docker compose ps",
        "db:logs": "docker compose logs --tail=50 postgres",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@telegram-apps/telegram-ui": "2.1.13",
        "fastify": "^5.12.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^20.19.43",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/telegram-web-app": "^10.1.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^6.4.1"
    }
}
